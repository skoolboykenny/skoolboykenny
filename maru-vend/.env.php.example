<?php
// Maru Vend settings for cPanel hosting. Copy to .env.php (same folder) and fill in.
// .env.php is outside public/, so it cannot be downloaded, and it is never committed.
foreach ([
    // Maru Vend database (created with ops/install/maru_vend_fresh_install.sql)
    'MV_DB_HOST' => 'localhost',
    'MV_DB_NAME' => 'maruquic_maru_vend',
    'MV_DB_USER' => '',            // a cPanel database user added to maruquic_maru_vend
    'MV_DB_PASS' => '',

    // Maru Power accounts live in the website database (power_users)
    'MV_ACCOUNTS_DB_HOST' => 'localhost',
    'MV_ACCOUNTS_DB_NAME' => 'maruquic_marugroupdata',
    'MV_ACCOUNTS_DB_USER' => '',   // a user with access to maruquic_marugroupdata
    'MV_ACCOUNTS_DB_PASS' => '',

    // Same value as MQ_POWER_SSO_SECRET in the website's includes/mq_secrets.php. 32+ random characters.
    'MV_SSO_SECRET' => '',

    // Folder of the website Maru Vend is installed in (public_html/maru-power). Empty if it has its own subdomain.
    'MV_BASE_PATH' => '/maru-power',

    'MV_PORTAL_KEY' => 'maru-power',   // the Maru Power sales channel created by the install
    'MV_PAYMENTS' => 'test',            // test payments until providers are contracted
    'MV_SECURE_COOKIES' => '1',         // the site runs on https
] as $k => $v) {
    putenv("$k=$v");
}
