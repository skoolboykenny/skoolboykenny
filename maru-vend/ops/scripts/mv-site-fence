#!/usr/bin/env bash
# Runs every 5 s on each database host (systemd timer mv-site-fence.timer).
#
# If this site's database is writable but the quorum names another site, or the quorum has been
# unreachable for longer than FENCE_AFTER_S, set read_only. Queue workers then stand by, so
# a site that is cut off can never keep vending while the other site takes over.
# It never un-fences: only mv-failover promotes a database.
. "$(dirname "$0")/mv-ops-lib.sh"

local_db=${LOCAL_DB:-127.0.0.1:3306}
state=${FENCE_STATE:-/run/maruvend-fence.since}

db_writable "$local_db" || { rm -f "$state"; exit 0; }   # already read-only: nothing to do

if active=$(quorum_active_site 2>/dev/null); then
  rm -f "$state"
  if [ -n "$active" ] && [ "$active" != "${MV_SITE:?}" ]; then
    log "Quorum says active site is '$active', this is '$MV_SITE': fencing $local_db"
    fence_db "$local_db"
  fi
  exit 0
fi

# No quorum. Tolerate short blips, then fence.
now=$(date +%s)
[ -f "$state" ] || echo "$now" > "$state"
since=$(cat "$state")
if [ $(( now - since )) -ge "$FENCE_AFTER_S" ]; then
  log "Quorum unreachable for $(( now - since ))s: fencing $local_db (vending stops at this site)"
  fence_db "$local_db"
fi
