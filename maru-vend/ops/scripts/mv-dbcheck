#!/usr/bin/env bash
# HTTP health check for HAProxy (systemd socket mv-dbcheck.socket on port 9200, one process per
# connection). Answers 200 only from the writable primary, so HAProxy always sends application
# database traffic to the one database that may accept writes.
. "$(dirname "$0")/mv-ops-lib.sh" 2>/dev/null || true
local_db=${LOCAL_DB:-127.0.0.1:3306}
read -r _ || true
if db_writable "$local_db" 2>/dev/null; then
  body="primary"; code="200 OK"
elif db_up "$local_db" 2>/dev/null; then
  body="replica"; code="503 Service Unavailable"
else
  body="down"; code="503 Service Unavailable"
fi
printf 'HTTP/1.1 %s\r\nContent-Type: text/plain\r\nContent-Length: %d\r\nConnection: close\r\n\r\n%s' "$code" "${#body}" "$body"
