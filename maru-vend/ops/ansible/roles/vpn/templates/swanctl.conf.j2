# Managed by Ansible (role vpn)
# strongSwan (swanctl) site-to-site tunnel from the Maru Vend VPN gateway to BPC.
# Implements Tender 7766/26 clause 7.3 / 2.2(c):
#   encryption AES-256, integrity SHA-256 or SHA-384, DH Group 19 preferred, Group 14 (2048-bit) minimum,
#   RSA 2048-bit certificates. Any weaker proposal from the peer is rejected (NO_PROPOSAL_CHOSEN).
#
# Values in <angle brackets> are agreed with BPC's network team after award.
# Deploy on BOTH gateways of the HA pair at each site; keepalived moves the public address on failure.

connections {
    bpc {
        version = 2                                   # IKEv2 only
        local_addrs  = {{ vpn_vip[mv_site] }}
        remote_addrs = {{ bpc_vpn_peer }}
        proposals = aes256gcm16-prfsha384-ecp256,aes256-sha384-ecp256,aes256-sha256-ecp256,aes256-sha256-modp2048
        rekey_time = 8h
        dpd_delay = 30s

        local {
            auth = pubkey
            certs = maruvend-gw.crt                   # RSA 2048+ signed by the agreed CA
            id = {{ vpn_local_id | default(inventory_hostname) }}
        }
        remote {
            auth = pubkey
            id = {{ bpc_vpn_id }}
        }
        children {
            bpc-vending {
                local_ts  = {{ app_subnet[mv_site] }}   # ONLY the XMLVend client hosts, never channel networks
                remote_ts = {{ bpc_vending_ip }}/32
                esp_proposals = aes256gcm16-ecp256,aes256gcm16-modp2048,aes256-sha384-ecp256,aes256-sha256-modp2048
                start_action = start
                dpd_action = restart
                close_action = start
                rekey_time = 1h
            }
        }
    }
}

# Site visit demonstration (2.3(d)):
#   swanctl --list-sas          shows the established SA: AES_GCM_16-256 / ECP_256
#   swanctl --list-conns        shows the policy above
#   A test peer offering 3des-sha1-modp1024 is refused: "no acceptable proposal found" in the charon log.
