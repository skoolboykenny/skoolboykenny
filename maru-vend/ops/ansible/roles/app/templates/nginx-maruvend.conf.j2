# Managed by Ansible. TLS terminates at HAProxy; nginx listens on the private network only.
# 8080: core API (/v1) and BPC dashboard (/bpc).  8081: channel apps (store, app, POS, USSD).
log_format mv '$remote_addr $http_x_forwarded_for [$time_local] "$request" $status $body_bytes_sent $request_time';

server {
    listen {{ ansible_host }}:8080;
    listen 127.0.0.1:8080;
    server_name {{ mv_domain_api }} {{ mv_domain_bpc }};
    root {{ mv_app_dir }}/public;
    access_log /var/log/nginx/maruvend-core.log mv;
    client_max_body_size 64k;
    set_real_ip_from {{ site_vip[mv_site] }};
    real_ip_header X-Forwarded-For;

    location / { try_files $uri /index.php$is_args$args; }
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param HTTPS on;
        fastcgi_pass unix:/run/php/maruvend.sock;
        fastcgi_read_timeout 180s;
    }
    location ~ /\. { deny all; }
}

server {
    listen {{ ansible_host }}:8081;
    server_name {{ mv_domain_store }};
    root {{ mv_app_dir }}/channels/public;
    access_log /var/log/nginx/maruvend-channels.log mv;
    client_max_body_size 16k;
    set_real_ip_from {{ site_vip[mv_site] }};
    real_ip_header X-Forwarded-For;

    location /assets/ { expires 7d; add_header Cache-Control "public"; }
    location = /sw.js { add_header Cache-Control "no-cache"; }
    location / { try_files $uri /index.php$is_args$args; }
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param HTTPS on;
        fastcgi_pass unix:/run/php/maruvend.sock;
        fastcgi_read_timeout 90s;
    }
    location ~ /\. { deny all; }
}
