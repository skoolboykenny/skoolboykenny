[Unit]
Description=Maru Vend: Sign the audit chain head

[Service]
Type=oneshot
User=maruvend
EnvironmentFile=/etc/maruvend/env
WorkingDirectory={{ mv_app_dir }}
ExecStart=/usr/bin/php bin/mv audit:anchor
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/var/lib/maruvend /var/log/maruvend
