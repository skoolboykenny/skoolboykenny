[Unit]
Description=Maru Vend customer SMS sender
After=network-online.target

[Service]
User=maruvend
EnvironmentFile=/etc/maruvend/env
WorkingDirectory={{ mv_app_dir }}
ExecStart=/usr/bin/php bin/mv sms
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/var/lib/maruvend /var/log/maruvend

[Install]
WantedBy=multi-user.target
