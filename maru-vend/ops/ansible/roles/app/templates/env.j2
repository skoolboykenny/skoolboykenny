# Managed by Ansible. Secrets come from ansible-vault.
MV_SITE={{ mv_site }}
MV_DB_HOST={{ site_vip[mv_site] }}
MV_DB_PORT=3307
MV_DB_NAME={{ db_name }}
MV_DB_USER={{ db_app_user }}
MV_DB_PASS={{ db_app_pass }}
MV_ANCHOR_DIR=/var/lib/maruvend/anchors
MV_ANCHOR_KEY_FILE=/etc/maruvend/anchor.key
MV_GPG_HOME=/var/lib/maruvend/gnupg
MV_BPC_KEY_FPR={{ vault_bpc_key_fpr | default('') }}
MV_SIGNER_KEY_FPR={{ vault_signer_key_fpr | default('') }}
MV_AGG_KEY={{ vault_agg_key | default('') }}
MV_AGG_PASS={{ vault_agg_pass | default('') }}
MV_AGG_OUTLET={{ vault_agg_outlet | default('') }}
MV_SMS_PROVIDER=http
MV_SMS_URL={{ vault_sms_url | default('') }}
MV_SMS_FALLBACK_URL={{ vault_sms_fallback_url | default('') }}
MV_SMS_TOKEN={{ vault_sms_token | default('') }}
MV_SMS_SENDER=MaruQuick
MV_PAYMENTS=live
MV_CORE_URL=http://127.0.0.1:8080
