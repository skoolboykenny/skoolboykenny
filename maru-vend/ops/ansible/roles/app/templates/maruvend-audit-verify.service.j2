[Unit]
Description=Maru Vend: Verify the audit chain and anchors (alerts on failure)

[Service]
Type=oneshot
User=maruvend
EnvironmentFile=/etc/maruvend/env
WorkingDirectory={{ mv_app_dir }}
ExecStart=/usr/bin/php bin/mv audit:verify
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/var/lib/maruvend /var/log/maruvend
