# Managed by Ansible
MV_SITE={{ mv_site }}
MV_SITES="primary dr"
SITE_DB_primary="{{ site_db.primary }}"
SITE_DB_dr="{{ site_db.dr }}"
ETCD_ENDPOINTS="{{ etcd_endpoints }}"
ETCD_CACERT=/etc/etcd/ca.crt
ETCD_CERT=/etc/etcd/client.crt
ETCD_KEY_FILE=/etc/etcd/client.key
DB_ADMIN_USER={{ db_ops_user }}
DB_ADMIN_PASS={{ db_ops_pass }}
REPL_USER={{ db_repl_user }}
REPL_PASS={{ db_repl_pass }}
REPL_SSL=1
MV_APP_DIR={{ mv_app_dir }}
LOCAL_DB=127.0.0.1:{{ db_port }}
FENCE_AFTER_S=15
FENCE_GRACE_S=30
