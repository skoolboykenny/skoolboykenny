#!/usr/bin/env bash
# Managed by Ansible (role backup). Usage: mv-backup full|incr
# Runs only on a READ-ONLY replica so backups never load the primary.
set -euo pipefail
. /etc/maruvend/ops.env
kind=${1:?full|incr}
db_writable() { [ "$(mariadb -N -B -e 'SELECT @@global.read_only')" = "0" ]; }
if db_writable; then echo "this node is the primary; backups run on replicas"; exit 0; fi

root=/var/backups/maruvend
mkdir -p "$root"
stamp=$(date +%Y%m%d-%H%M)
last_full=$(ls -1d "$root"/full-* 2>/dev/null | tail -1 || true)
target="$root/$kind-$stamp"
args=(--backup --target-dir="$target" --user={{ db_ops_user }} --password='{{ db_ops_pass }}' --slave-info --safe-slave-backup)
[ "$kind" = incr ] && { [ -n "$last_full" ] || { echo "no full backup yet"; exit 1; }; args+=(--incremental-basedir="$last_full"); }
mariabackup "${args[@]}"
tar -C "$root" -cf - "$(basename "$target")" | zstd -q | gpg --batch --yes --trust-model always \
  --recipient '{{ backup_gpg_recipient }}' --cipher-algo AES256 --encrypt -o "$target.tar.zst.gpg"
rm -rf "$target"
# Copy to the other site (rsync over SSH with a restricted key).
other={{ 'dr' if mv_site == 'primary' else 'primary' }}
rsync -a --chmod=F600 "$target.tar.zst.gpg" "backup@{{ backup_peer | default('backup-host') }}:/srv/backups/maruvend/$(hostname)/"
find "$root" -name '*.gpg' -mtime +{{ backup_retention_days }} -delete
echo "backup $kind ok: $target.tar.zst.gpg"
